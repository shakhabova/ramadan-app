{
  "expo": {
    "name": "Ramadan Tracker",
    "slug": "ramadan-app",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ramadantracker.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ramadantracker.app"
    },
    "scheme": "ramadanapp",
    "extra": {
      "router": {
        "root": "src/app"
      },
      "eas": {
        "projectId": "818fa0f4-ff96-40fc-85bb-ace250abe32c"
      }
    },
    "plugins": [
      "@ng-native/metro/app.plugin.cjs",
      "expo-status-bar",
      "expo-sharing"
    ],
    "owner": "husaynables-team"
  }
}
